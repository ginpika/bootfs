TFS_WEB_ENTRYPOINT=http://localhost:8181
TFS_COPIES=1
# Enable Hostid authentication or explicitly disable it for a trusted local instance.
SSO_ENABLED=true
SSO_SERVER_URL=http://localhost:3001
SSO_INFO_URL=http://localhost:3000/sso/info
# S3 and browser uploads use one catalog; ordinary upload keys are their resource UUIDs.
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bootfs
# Shared private-network transfer credential for multi-node HTTP object replication.
BOOTFS_CLUSTER_TOKEN=

# "single-local" preserves old TFS_COPIES asynchronous repair behavior.
# "replicated" requires k distinct durable nodes before publication; 0 uses TFS_COPIES.
BOOTFS_OBJECT_WRITE_POLICY=single-local
BOOTFS_OBJECT_REQUIRED_COPIES=0
BOOTFS_OBJECT_PREPARE_TIMEOUT_MS=30000
# Use "dynamic" for independent nodes that discover, merge and join at runtime.
# Existing embedded/static data must first use portable backup/restore into a new root.
BOOTFS_METADATA_MODE=embedded
BOOTFS_CLUSTER_DISCOVERY_ENABLED=true
# Set a stable reachable host:port and expose that TCP port when using containers.
BOOTFS_CLUSTER_RAFT_ADDRESS=
# Explicitly enable only on a protected LAN/tunnel until Raft mTLS is available.
BOOTFS_RAFT_ALLOW_INSECURE_NETWORK=false
