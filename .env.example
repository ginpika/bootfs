TFS_WEB_ENTRYPOINT=http://localhost:8181
TFS_COPIES=1
# Enable Hostid authentication or explicitly disable it for a trusted local instance.
SSO_ENABLED=true
SSO_SERVER_URL=http://localhost:3001
SSO_INFO_URL=http://localhost:3000/sso/info
# S3 and browser uploads use one catalog; ordinary upload keys are their resource UUIDs.
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bootfs
# Optional local management/legacy transfer credential; never shared by new federation pairing.
BOOTFS_CLUSTER_TOKEN=

# "single-local" preserves old TFS_COPIES asynchronous repair behavior.
# "replicated" requires k distinct durable nodes before publication; 0 uses TFS_COPIES.
BOOTFS_OBJECT_WRITE_POLICY=single-local
BOOTFS_OBJECT_REQUIRED_COPIES=0
BOOTFS_OBJECT_PREPARE_TIMEOUT_MS=30000
# "auto" enables local authority and pairing for new and existing local embedded roots.
# Old shared-Raft dynamic storage requires portable backup/restore; its original files stay intact.
BOOTFS_METADATA_MODE=auto
